# Collapse generated files in GitHub diffs and exclude them from language stats.
# https://docs.github.com/en/repositories/working-with-files/managing-files/customizing-how-changed-files-appear-on-github
# Do not hand-edit files matched here; change the generator or its inputs instead.

# Service clients generated by smithy-swift-codegen (codegen/sdk-codegen `stageSdks`;
# scripts/codegen.sh deletes and recreates these directories wholesale).
/Sources/Services/** linguist-generated=true
/Sources/Core/AWSSDKIdentity/InternalClients/** linguist-generated=true

# Files written by AWSSDKSwiftCLI (generate-package-manifest, generate-package-version,
# generate-partitions, generate-doc-index).
/Package.swift linguist-generated=true
/Sources/Core/AWSSDKDynamic/Sources/AWSSDKDynamic/PackageVersion.swift linguist-generated=true
/Sources/Core/AWSSDKDynamic/Sources/AWSSDKDynamic/Partitions.swift linguist-generated=true
/Sources/Core/SDKForSwift/Documentation.docc/SDKForSwift.md linguist-generated=true

# Upstream API models and endpoint/partition data, copied in verbatim by release automation.
/codegen/sdk-codegen/aws-models/** linguist-generated=true
/codegen/sdk-codegen/sdk-*.json linguist-generated=true
